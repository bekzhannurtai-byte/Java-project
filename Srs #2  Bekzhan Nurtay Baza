DROP DATABASE IF EXISTS MedicineDB;
CREATE DATABASE MedicineDB;
USE MedicineDB;

CREATE TABLE Patients (
    PatientID INT PRIMARY KEY AUTO_INCREMENT,
    PatientFirstName VARCHAR(50) NOT NULL,
    PatientLastName VARCHAR(50) NOT NULL,
    PatientMiddleName VARCHAR(50),
    PatientSSN CHAR(12) UNIQUE NOT NULL,
    PatientBirthDate DATE NOT NULL,
    PatientPhone VARCHAR(20),
    PatientEmail VARCHAR(100),
    PatientAddress TEXT,
    RegistrationDate DATETIME DEFAULT CURRENT_TIMESTAMP,
    IsActive BOOLEAN DEFAULT TRUE
);

CREATE TABLE InsuranceTypes (
    InsuranceTypeID INT PRIMARY KEY AUTO_INCREMENT,
    InsuranceTypeName VARCHAR(100) NOT NULL UNIQUE,
    InsuranceTypeDescription TEXT,
    DefaultCoveragePercent DECIMAL(5,2) DEFAULT 100.00,
    IsGovernment BOOLEAN DEFAULT FALSE,
    priority_level INT DEFAULT 1
);

CREATE TABLE Insurances (
    InsuranceID INT PRIMARY KEY AUTO_INCREMENT,
    PatientID INT NOT NULL,
    InsuranceTypeID INT NOT NULL,
    InsuranceNumber VARCHAR(50) UNIQUE NOT NULL,
    InsuranceCompany VARCHAR(100),
    StartDate DATE NOT NULL,
    EndDate DATE NOT NULL,
    CoverageAmount DECIMAL(15,2),
    MonthlyPayment DECIMAL(10,2),
    IsActive BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (PatientID) REFERENCES Patients(PatientID) ON DELETE CASCADE,
    FOREIGN KEY (InsuranceTypeID) REFERENCES InsuranceTypes(InsuranceTypeID)
);

CREATE TABLE Doctors (
    DoctorID INT PRIMARY KEY AUTO_INCREMENT,
    DoctorFirstName VARCHAR(50) NOT NULL,
    DoctorLastName VARCHAR(50) NOT NULL,
    DoctorMiddleName VARCHAR(50),
    Specialization VARCHAR(100) NOT NULL,
    LicenseNumber VARCHAR(50) UNIQUE NOT NULL,
    ExperienceYears INT DEFAULT 0,
    Phone VARCHAR(20),
    Email VARCHAR(100),
    CabinetNumber VARCHAR(10),
    ConsultationPrice DECIMAL(10,2),
    IsActive BOOLEAN DEFAULT TRUE
);

CREATE TABLE MedicalServices (
    ServiceID INT PRIMARY KEY AUTO_INCREMENT,
    ServiceCode VARCHAR(20) UNIQUE NOT NULL,
    ServiceName VARCHAR(200) NOT NULL,
    ServiceCategory VARCHAR(100),
    BasePrice DECIMAL(10,2) NOT NULL,
    DurationMinutes INT DEFAULT 30,
    IsActive BOOLEAN DEFAULT TRUE
);

CREATE TABLE Visits (
    VisitID INT PRIMARY KEY AUTO_INCREMENT,
    PatientID INT NOT NULL,
    DoctorID INT NOT NULL,
    VisitDate DATE NOT NULL,
    VisitTime TIME NOT NULL,
    VisitType ENUM('Амбулаторлық', 'Стационарлық', 'Үйге шақыру', 'Кеңес') DEFAULT 'Амбулаторлық',
    Status ENUM('Жоспарланған', 'Аяқталған', 'Болдырмаған', 'Кейінге қалдырылған') DEFAULT 'Жоспарланған',
    Complaint TEXT,
    Diagnosis TEXT,
    Prescription TEXT,
    FOREIGN KEY (PatientID) REFERENCES Patients(PatientID),
    FOREIGN KEY (DoctorID) REFERENCES Doctors(DoctorID)
);

CREATE TABLE VisitServices (
    VisitServiceID INT PRIMARY KEY AUTO_INCREMENT,
    VisitID INT NOT NULL,
    ServiceID INT NOT NULL,
    Quantity INT DEFAULT 1,
    ActualPrice DECIMAL(10,2) NOT NULL,
    DiscountPercent DECIMAL(5,2) DEFAULT 0,
    FOREIGN KEY (VisitID) REFERENCES Visits(VisitID) ON DELETE CASCADE,
    FOREIGN KEY (ServiceID) REFERENCES MedicalServices(ServiceID)
);

CREATE TABLE Payments (
    PaymentID INT PRIMARY KEY AUTO_INCREMENT,
    VisitID INT NOT NULL,
    PaymentDate DATETIME DEFAULT CURRENT_TIMESTAMP,
    TotalAmount DECIMAL(12,2) NOT NULL,
    InsurancePaid DECIMAL(12,2) DEFAULT 0,
    PatientPaid DECIMAL(12,2) DEFAULT 0,
    PaymentMethod ENUM('Қолма-қол', 'Карта', 'Аудирум', 'Kaspi') DEFAULT 'Қолма-қол',
    PaymentStatus ENUM('Төленді', 'Ішінара төленді', 'Төленбеді') DEFAULT 'Төленбеді',
    FOREIGN KEY (VisitID) REFERENCES Visits(VisitID)
);

CREATE TABLE AuditLog (
    LogID INT PRIMARY KEY AUTO_INCREMENT,
    TableName VARCHAR(50),
    ActionType VARCHAR(20),
    RecordID INT,
    OldData TEXT,
    NewData TEXT,
    ChangedBy VARCHAR(100),
    ChangeDate DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE SystemSettings (
    SettingID INT PRIMARY KEY AUTO_INCREMENT,
    SettingKey VARCHAR(100) UNIQUE NOT NULL,
    SettingValue TEXT,
    Description TEXT
);

