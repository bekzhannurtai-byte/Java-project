CREATE PROCEDURE sp_RegisterPatient(
    IN p_FirstName VARCHAR(50),
    IN p_LastName VARCHAR(50),
    IN p_SSN CHAR(12),
    IN p_BirthDate DATE,
    IN p_Phone VARCHAR(20)
)
BEGIN
    INSERT INTO Patients (PatientFirstName, PatientLastName, PatientSSN, PatientBirthDate, PatientPhone)
    VALUES (p_FirstName, p_LastName, p_SSN, p_BirthDate, p_Phone);
    
    SELECT CONCAT('Науқас ', p_FirstName, ' ', p_LastName, ' тіркелді. ID: ', LAST_INSERT_ID()) AS Result;
END//

CREATE PROCEDURE sp_CreateVisitWithServices(
    IN p_PatientID INT,
    IN p_DoctorID INT,
    IN p_VisitDate DATE,
    IN p_VisitTime TIME,
    IN p_ServiceIDs VARCHAR(500),
    IN p_Quantities VARCHAR(500)
)
BEGIN
    DECLARE v_VisitID INT;
    DECLARE v_TotalAmount DECIMAL(12,2);
    DECLARE v_InsuranceCoverage DECIMAL(5,2);
    DECLARE v_InsurancePaid DECIMAL(12,2);
    DECLARE v_PatientPaid DECIMAL(12,2);
    DECLARE v_ServiceID INT;
    DECLARE v_Quantity INT;
    DECLARE v_Price DECIMAL(10,2);
    DECLARE v_Pos INT;
    DECLARE v_ServicePos INT;
    DECLARE v_Done INT DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SELECT 'Қате: Келу жасалмады. Транзакция кері қайтарылды.' AS ErrorMessage;
    END;
    
    START TRANSACTION;
    
    SELECT DefaultCoveragePercent INTO v_InsuranceCoverage
    FROM Insurances i
    JOIN InsuranceTypes it ON i.InsuranceTypeID = it.InsuranceTypeID
    WHERE i.PatientID = p_PatientID AND i.IsActive = TRUE AND CURDATE() BETWEEN i.StartDate AND i.EndDate
    LIMIT 1;
    
    IF v_InsuranceCoverage IS NULL THEN
        SET v_InsuranceCoverage = 0;
    END IF;
    
    INSERT INTO Visits (PatientID, DoctorID, VisitDate, VisitTime, Status)
    VALUES (p_PatientID, p_DoctorID, p_VisitDate, p_VisitTime, 'Жоспарланған');
    
    SET v_VisitID = LAST_INSERT_ID();
    SET v_TotalAmount = 0;
    
    WHILE p_ServiceIDs != '' AND p_Quantities != '' AND v_Done = 0 DO
        SET v_Pos = LOCATE(',', p_ServiceIDs);
        IF v_Pos = 0 THEN
            SET v_ServiceID = CAST(p_ServiceIDs AS UNSIGNED);
            SET v_Quantity = CAST(p_Quantities AS UNSIGNED);
            SET v_Done = 1;
        ELSE
            SET v_ServiceID = CAST(SUBSTRING(p_ServiceIDs, 1, v_Pos - 1) AS UNSIGNED);
            SET v_Quantity = CAST(SUBSTRING(p_Quantities, 1, LOCATE(',', p_Quantities) - 1) AS UNSIGNED);
            SET p_ServiceIDs = SUBSTRING(p_ServiceIDs, v_Pos + 1);
            SET p_Quantities = SUBSTRING(p_Quantities, LOCATE(',', p_Quantities) + 1);
        END IF;
        
        SELECT BasePrice INTO v_Price FROM MedicalServices WHERE ServiceID = v_ServiceID;
        
        INSERT INTO VisitServices (VisitID, ServiceID, Quantity, ActualPrice)
        VALUES (v_VisitID, v_ServiceID, v_Quantity, v_Price);
        
        SET v_TotalAmount = v_TotalAmount + (v_Price * v_Quantity);
    END WHILE;
    
    SET v_InsurancePaid = v_TotalAmount * (v_InsuranceCoverage / 100);
    SET v_PatientPaid = v_TotalAmount - v_InsurancePaid;
    
    INSERT INTO Payments (VisitID, TotalAmount, InsurancePaid, PatientPaid, PaymentStatus)
    VALUES (v_VisitID, v_TotalAmount, v_InsurancePaid, v_PatientPaid, 'Төленбеді');
    
    COMMIT;
    
    SELECT CONCAT('Келу жасалды. ID: ', v_VisitID, ', Жалпы сома: ', v_TotalAmount, 
                  ', Сақтандыру төледі: ', v_InsurancePaid, ', Науқас төлейді: ', v_PatientPaid) AS Result;
END//

CREATE PROCEDURE sp_UpdateVisitStatus(
    IN p_VisitID INT,
    IN p_NewStatus ENUM('Жоспарланған', 'Аяқталған', 'Болдырмаған', 'Кейінге қалдырылған')
)
BEGIN
    DECLARE v_OldStatus VARCHAR(20);
    
    SELECT Status INTO v_OldStatus FROM Visits WHERE VisitID = p_VisitID;
    
    UPDATE Visits SET Status = p_NewStatus WHERE VisitID = p_VisitID;
    
    INSERT INTO AuditLog (TableName, ActionType, RecordID, OldData, NewData, ChangedBy)
    VALUES ('Visits', 'STATUS_UPDATE', p_VisitID, 
            CONCAT('{"status":"', v_OldStatus, '"}'),
            CONCAT('{"status":"', p_NewStatus, '"}'),
            CURRENT_USER());
    
    SELECT CONCAT('Visit ', p_VisitID, ' статусы ', v_OldStatus, ' -> ', p_NewStatus, ' өзгертілді') AS Result;
END//

CREATE PROCEDURE sp_ProcessPayment(
    IN p_VisitID INT,
    IN p_PaymentAmount DECIMAL(12,2),
    IN p_PaymentMethod ENUM('Қолма-қол', 'Карта', 'Аудирум', 'Kaspi')
)
BEGIN
    DECLARE v_PatientPaid DECIMAL(12,2);
    DECLARE v_Remaining DECIMAL(12,2);
    
    START TRANSACTION;
    
    SELECT PatientPaid INTO v_PatientPaid FROM Payments WHERE VisitID = p_VisitID;
    
    SET v_Remaining = v_PatientPaid - p_PaymentAmount;
    
    IF v_Remaining <= 0 THEN
        UPDATE Payments 
        SET PatientPaid = 0, 
            PaymentMethod = p_PaymentMethod,
            PaymentStatus = 'Төленді',
            PaymentDate = NOW()
        WHERE VisitID = p_VisitID;
    ELSE
        UPDATE Payments 
        SET PatientPaid = v_Remaining,
            PaymentMethod = p_PaymentMethod,
            PaymentStatus = 'Ішінара төленді',
            PaymentDate = NOW()
        WHERE VisitID = p_VisitID;
    END IF;
    
    COMMIT;
    
    SELECT CONCAT('Төлем қабылданды. Қалған сома: ', GREATEST(v_Remaining, 0)) AS Result;
END//

CREATE PROCEDURE sp_GetPatientFinancialReport(IN p_PatientID INT)
BEGIN
    SELECT 
        p.PatientLastName AS Науқас_Тегі,
        p.PatientFirstName AS Науқас_Аты,
        COUNT(DISTINCT v.VisitID) AS Келу_саны,
        SUM(pay.TotalAmount) AS Жалпы_сома,
        SUM(pay.InsurancePaid) AS Сақтандыру_төлемі,
        SUM(pay.PatientPaid) AS Науқас_төлемі,
        CASE 
            WHEN SUM(pay.PatientPaid) = 0 THEN 'Толық төленді'
            WHEN SUM(pay.PatientPaid) > 0 AND SUM(pay.PatientPaid) < SUM(pay.TotalAmount) THEN 'Ішінара төленді'
            ELSE 'Төленбеді'
        END AS Қаржылық_жағдай
    FROM Patients p
    LEFT JOIN Visits v ON p.PatientID = v.PatientID
    LEFT JOIN Payments pay ON v.VisitID = pay.VisitID
    WHERE p.PatientID = p_PatientID
    GROUP BY p.PatientID;
END//

CREATE PROCEDURE sp_GetDoctorPerformance(IN p_DoctorID INT, IN p_StartDate DATE, IN p_EndDate DATE)
BEGIN
    SELECT 
        d.DoctorLastName AS Дәрігер_Тегі,
        d.DoctorFirstName AS Дәрігер_Аты,
        d.Specialization AS Мамандығы,
        COUNT(DISTINCT v.VisitID) AS Қабылдау_саны,
        COUNT(DISTINCT v.PatientID) AS Науқас_саны,
        SUM(pay.TotalAmount) AS Жалпы_табыс,
        SUM(pay.InsurancePaid) AS Сақтандыру_арқылы,
        SUM(pay.PatientPaid) AS Науқас_арқылы,
        AVG(pay.TotalAmount) AS Орташа_келу_сомасы
    FROM Doctors d
    LEFT JOIN Visits v ON d.DoctorID = v.DoctorID AND v.VisitDate BETWEEN p_StartDate AND p_EndDate
    LEFT JOIN Payments pay ON v.VisitID = pay.VisitID
    WHERE d.DoctorID = p_DoctorID OR p_DoctorID IS NULL
    GROUP BY d.DoctorID;
END//

CREATE FUNCTION fn_GetPatientAge(p_PatientID INT) RETURNS INT DETERMINISTIC
BEGIN
    DECLARE v_Age INT;
    SELECT TIMESTAMPDIFF(YEAR, PatientBirthDate, CURDATE()) INTO v_Age
    FROM Patients WHERE PatientID = p_PatientID;
    RETURN v_Age;
END//

CREATE FUNCTION fn_GetTotalPaidByPatient(p_PatientID INT) RETURNS DECIMAL(15,2) DETERMINISTIC
BEGIN
    DECLARE v_Total DECIMAL(15,2);
    SELECT COALESCE(SUM(PatientPaid), 0) INTO v_Total
    FROM Payments pay
    JOIN Visits v ON pay.VisitID = v.VisitID
    WHERE v.PatientID = p_PatientID;
    RETURN v_Total;
END//

CREATE FUNCTION fn_GetInsuranceValidity(p_InsuranceID INT) RETURNS VARCHAR(50) DETERMINISTIC
BEGIN
    DECLARE v_EndDate DATE;
    DECLARE v_Result VARCHAR(50);
    
    SELECT EndDate INTO v_EndDate FROM Insurances WHERE InsuranceID = p_InsuranceID;
    
    IF v_EndDate < CURDATE() THEN
        SET v_Result = 'Мерзімі өткен';
    ELSEIF v_EndDate < DATE_ADD(CURDATE(), INTERVAL 30 DAY) THEN
        SET v_Result = 'Жақында мерзімі аяқталады';
    ELSE
        SET v_Result = 'Жарамды';
    END IF;
    
    RETURN v_Result;
END//

CREATE FUNCTION fn_CalculateDiscountPrice(p_Price DECIMAL(10,2), p_DiscountPercent DECIMAL(5,2)) 
RETURNS DECIMAL(10,2) DETERMINISTIC
BEGIN
    RETURN p_Price * (1 - p_DiscountPercent / 100);
END//

CREATE TRIGGER trg_BeforeInsertVisit
BEFORE INSERT ON Visits
FOR EACH ROW
BEGIN
    DECLARE v_DoctorWorkStart TIME;
    DECLARE v_DoctorWorkEnd TIME;
    
    SELECT WorkStartTime, WorkEndTime INTO v_DoctorWorkStart, v_DoctorWorkEnd
    FROM Doctors WHERE DoctorID = NEW.DoctorID;
    
    IF v_DoctorWorkStart IS NOT NULL AND v_DoctorWorkEnd IS NOT NULL THEN
        IF NEW.VisitTime < v_DoctorWorkStart OR NEW.VisitTime > v_DoctorWorkEnd THEN
            SIGNAL SQLSTATE '45000' 
            SET MESSAGE_TEXT = 'Дәрігердің жұмыс уақытынан тыс келу жасауға болмайды';
        END IF;
    END IF;
    
    IF EXISTS (
        SELECT 1 FROM Visits 
        WHERE DoctorID = NEW.DoctorID 
        AND VisitDate = NEW.VisitDate 
        AND VisitTime = NEW.VisitTime
        AND Status != 'Болдырмаған'
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Бұл уақытта дәрігерде келу бар';
    END IF;
END//

CREATE TRIGGER trg_AfterUpdatePatient
AFTER UPDATE ON Patients
FOR EACH ROW
BEGIN
    IF OLD.PatientPhone != NEW.PatientPhone OR OLD.PatientAddress != NEW.PatientAddress THEN
        INSERT INTO AuditLog (TableName, ActionType, RecordID, OldData, NewData, ChangedBy)
        VALUES ('Patients', 'UPDATE', NEW.PatientID,
                CONCAT('{"phone":"', OLD.PatientPhone, '","address":"', OLD.PatientAddress, '"}'),
                CONCAT('{"phone":"', NEW.PatientPhone, '","address":"', NEW.PatientAddress, '"}'),
                CURRENT_USER());
    END IF;
END//

CREATE TRIGGER trg_InsteadOfDeleteInsurance
INSTEAD OF DELETE ON Insurances
FOR EACH ROW
BEGIN
    UPDATE Insurances 
    SET IsActive = FALSE, 
        EndDate = CURDATE()
    WHERE InsuranceID = OLD.InsuranceID;
    
    INSERT INTO AuditLog (TableName, ActionType, RecordID, OldData, NewData, ChangedBy)
    VALUES ('Insurances', 'SOFT_DELETE', OLD.InsuranceID,
            CONCAT('{"insuranceNumber":"', OLD.InsuranceNumber, '"}'),
            CONCAT('{"isActive":false, "endDate":"', CURDATE(), '"}'),
            CURRENT_USER());
END//

CREATE TRIGGER trg_AfterInsertPayment
AFTER INSERT ON Payments
FOR EACH ROW
BEGIN
    UPDATE Visits 
    SET Status = 'Аяқталған'
    WHERE VisitID = NEW.VisitID AND NEW.PaymentStatus = 'Төленді';
END//

CREATE EVENT IF NOT EXISTS evt_CheckExpiredInsurances
ON SCHEDULE EVERY 1 DAY
STARTS CURRENT_TIMESTAMP
DO
BEGIN
    INSERT INTO AuditLog (TableName, ActionType, RecordID, OldData, NewData, ChangedBy)
    SELECT 'Insurances', 'EXPIRED_CHECK', InsuranceID,
           CONCAT('{"endDate":"', EndDate, '"}'),
           CONCAT('{"isActive":', IF(EndDate < CURDATE(), 'false', 'true'), '}'),
           'SYSTEM'
    FROM Insurances
    WHERE EndDate < CURDATE() AND IsActive = TRUE;
    
    UPDATE Insurances 
    SET IsActive = FALSE 
    WHERE EndDate < CURDATE() AND IsActive = TRUE;
END//

