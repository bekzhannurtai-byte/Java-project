SELECT 
    v.VisitID,
    p.PatientLastName,
    d.DoctorLastName,
    v.VisitDate,
    pay.TotalAmount,
    pay.PaymentStatus
FROM Visits v
JOIN Patients p ON v.PatientID = p.PatientID
JOIN Doctors d ON v.DoctorID = d.DoctorID
JOIN Payments pay ON v.VisitID = pay.VisitID
ORDER BY v.VisitDate DESC;
